{
  "id": "describe-your-experience",
  "section": "b1",
  "position": 1,
  "review": {
    "en": "draft",
    "am": "draft",
    "om": "draft"
  },
  "guidebook": {
    "en": {
      "title": "Describe your experience",
      "goal": "Talk about your role, how long you have worked, and what you want to learn.",
      "introduction": "These sentences help you talk about work you already know. Keep each answer to one idea.",
      "notes": [
        {
          "explanation": "Have worked talks about time up to now.",
          "examples": [
            "years",
            "current-role",
            "responsibility"
          ]
        },
        {
          "explanation": "A challenge can be honest and short.",
          "examples": [
            "challenge",
            "achievement",
            "colleague"
          ]
        },
        {
          "explanation": "End with what you want next.",
          "examples": [
            "future",
            "proud"
          ]
        }
      ]
    },
    "am": {
      "title": "ልምድዎን ይግለጹ",
      "goal": "ስለ ሚናዎ፣ ለምን ያህል ጊዜ እንደሠሩ እና ምን መማር እንደሚፈልጉ ይናገሩ።",
      "introduction": "እነዚህ ዓረፍተ ነገሮች የሚያውቁትን ሥራ ለመናገር ይረዳሉ። እያንዳንዱን መልስ በአንድ ሐሳብ ይጠብቁ።",
      "notes": [
        {
          "explanation": "Have worked እስከ አሁን ድረስ ስላለው ጊዜ ይናገራል።",
          "examples": [
            "years",
            "current-role",
            "responsibility"
          ]
        },
        {
          "explanation": "ፈተና ታማኝ እና አጭር ሊሆን ይችላል።",
          "examples": [
            "challenge",
            "achievement",
            "colleague"
          ]
        },
        {
          "explanation": "ቀጥሎ በሚፈልጉት ይጨርሱ።",
          "examples": [
            "future",
            "proud"
          ]
        }
      ]
    },
    "om": {
      "title": "Muuxannoo kee ibsi",
      "goal": "Waa'ee gahee kee, yeroo hangam hojjettu fi waan barachuu barbaaddu dubbadhu.",
      "introduction": "Jechoonni kun hojii duraan beektu irratti dubbachuuf si gargaaru. Deebii tokko tokko yaada tokko qofa haa qabaatu.",
      "notes": [
        {
          "explanation": "Have worked yeroo hamma ammaatti ibsa.",
          "examples": [
            "years",
            "current-role",
            "responsibility"
          ]
        },
        {
          "explanation": "Rakkoon tokko dhugaa fi gabaabaa ta'uu danda'a.",
          "examples": [
            "challenge",
            "achievement",
            "colleague"
          ]
        },
        {
          "explanation": "Waan itti aanu barbaadduun xumuri.",
          "examples": [
            "future",
            "proud"
          ]
        }
      ]
    }
  },
  "phrases": [
    {
      "id": "current-role",
      "english": {
        "text": "I work as a sales assistant."
      },
      "meaning": {
        "en": {
          "text": "My job title is sales assistant."
        },
        "am": {
          "text": "የሽያጭ ረዳት ሆኜ እሠራለሁ።"
        },
        "om": {
          "text": "Gargaaraa gurgurtaa ta'ee hojjedha."
        }
      },
      "hint": {
        "en": "As names your role.",
        "am": "As ሚናዎን ይሰይማል።",
        "om": "As gahee kee moggaasa."
      }
    },
    {
      "id": "years",
      "english": {
        "text": "I have worked here for two years."
      },
      "meaning": {
        "en": {
          "text": "Two years is how long I have been here."
        },
        "am": {
          "text": "እዚህ ለሁለት ዓመት ሠርቻለሁ።"
        },
        "om": {
          "text": "Waggaa lama as hojjedheera."
        }
      },
      "hint": {
        "en": "For two years names the length of time.",
        "am": "For two years የጊዜውን ርዝመት ይሰይማል።",
        "om": "For two years dheerina yeroo ibsa."
      }
    },
    {
      "id": "responsibility",
      "english": {
        "text": "I help customers every day."
      },
      "meaning": {
        "en": {
          "text": "Helping customers is my daily work."
        },
        "am": {
          "text": "በየቀኑ ደንበኞችን እረዳለሁ።"
        },
        "om": {
          "text": "Guyyaa guyyaan maamiltoota gargaara."
        }
      },
      "hint": {
        "en": "Every day says how often.",
        "am": "Every day ምን ያህል ጊዜ እንደሆነ ይነግራል።",
        "om": "Every day yeroo meeqa akka ta'e hima."
      }
    },
    {
      "id": "achievement",
      "english": {
        "text": "I learned to use the register."
      },
      "meaning": {
        "en": {
          "text": "Using the register is a skill I gained."
        },
        "am": {
          "text": "መዝገቡን መጠቀም ተምሬያለሁ።"
        },
        "om": {
          "text": "Galmeessa fayyadamuun baradheera."
        }
      },
      "hint": {
        "en": "Learned shows a skill you gained.",
        "am": "Learned ያገኙትን ክህሎት ያሳያል።",
        "om": "Learned dandeettii argatte agarsiisa."
      }
    },
    {
      "id": "challenge",
      "english": {
        "text": "The busy days are hard."
      },
      "meaning": {
        "en": {
          "text": "Busy days are difficult."
        },
        "am": {
          "text": "የተጨናነቁ ቀናት ከባድ ናቸው።"
        },
        "om": {
          "text": "Guyyaan hojii baay'ee ulfaataadha."
        }
      },
      "hint": {
        "en": "Hard names the difficulty.",
        "am": "Hard ችግሩን ይሰይማል።",
        "om": "Hard rakkina moggaasa."
      }
    },
    {
      "id": "future",
      "english": {
        "text": "I want to learn more."
      },
      "meaning": {
        "en": {
          "text": "I hope to keep learning."
        },
        "am": {
          "text": "የበለጠ መማር እፈልጋለሁ።"
        },
        "om": {
          "text": "Caalaatti barachuu barbaada."
        }
      },
      "hint": {
        "en": "More points to the next step.",
        "am": "More ቀጣዩን እርምጃ ያመለክታል።",
        "om": "More tarkaanfii itti aanu agarsiisa."
      }
    },
    {
      "id": "colleague",
      "english": {
        "text": "My colleagues help me."
      },
      "meaning": {
        "en": {
          "text": "The people I work with support me."
        },
        "am": {
          "text": "የሥራ ባልደረቦቼ ይረዱኛል።"
        },
        "om": {
          "text": "Hojjetoonni koo na gargaaru."
        }
      },
      "hint": {
        "en": "Colleagues are the people you work with.",
        "am": "Colleagues አብረውዎት የሚሠሩ ሰዎች ናቸው።",
        "om": "Colleagues namoota waliin hojjettu."
      }
    },
    {
      "id": "proud",
      "english": {
        "text": "I am proud of my work."
      },
      "meaning": {
        "en": {
          "text": "My work makes me feel good."
        },
        "am": {
          "text": "በሥራዬ እኮራለሁ።"
        },
        "om": {
          "text": "Hojii kootiin boona."
        }
      },
      "hint": {
        "en": "Of my work names what you feel proud of.",
        "am": "Of my work የሚኮሩበትን ይሰይማል።",
        "om": "Of my work waan itti boontu moggaasa."
      }
    }
  ],
