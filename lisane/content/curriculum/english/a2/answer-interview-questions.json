{
  "id": "answer-interview-questions",
  "section": "a2",
  "position": 1,
  "review": {
    "en": "draft",
    "am": "draft",
    "om": "draft"
  },
  "guidebook": {
    "en": {
      "title": "Answer interview questions",
      "goal": "Say why you want the job, name a strength, and ask one question.",
      "introduction": "A short interview uses a few clear answers. You do not need a long story.",
      "notes": [
        {
          "explanation": "I want and I can answer the first questions.",
          "examples": [
            "why-job",
            "available",
            "question-back"
          ]
        },
        {
          "explanation": "These name how you work with other people.",
          "examples": [
            "strength",
            "team",
            "learn-fast"
          ]
        },
        {
          "explanation": "A past job can be one short sentence.",
          "examples": [
            "experience",
            "thank-interview"
          ]
        }
      ]
    },
    "am": {
      "title": "የቃለ መጠይቅ ጥያቄዎችን ይመልሱ",
      "goal": "ሥራውን ለምን እንደሚፈልጉ ይናገሩ፣ አንድ ጥንካሬ ይጥቀሱ እና አንድ ጥያቄ ይጠይቁ።",
      "introduction": "አጭር ቃለ መጠይቅ ጥቂት ግልጽ መልሶችን ይጠቀማል። ረጅም ታሪክ አያስፈልግም።",
      "notes": [
        {
          "explanation": "I want እና I can የመጀመሪያዎቹን ጥያቄዎች ይመልሳሉ።",
          "examples": [
            "why-job",
            "available",
            "question-back"
          ]
        },
        {
          "explanation": "እነዚህ ከሰዎች ጋር እንዴት እንደሚሠሩ ይገልጻሉ።",
          "examples": [
            "strength",
            "team",
            "learn-fast"
          ]
        },
        {
          "explanation": "ያለፈ ሥራ አንድ አጭር ዓረፍተ ነገር ሊሆን ይችላል።",
          "examples": [
            "experience",
            "thank-interview"
          ]
        }
      ]
    },
    "om": {
      "title": "Gaaffii af-gaaffii deebisi",
      "goal": "Maaliif hojii kana barbaaddu himi, cimina kee tokko ibsi, gaaffii tokko gaafadhu.",
      "introduction": "Af-gaaffiin gabaabaan deebii ifa muraasa fayyadama. Seenaa dheeraa hin barbaachisu.",
      "notes": [
        {
          "explanation": "I want fi I can gaaffii jalqabaa deebisu.",
          "examples": [
            "why-job",
            "available",
            "question-back"
          ]
        },
        {
          "explanation": "Isaan kun nama biraa waliin akka hojjettu ibsu.",
          "examples": [
            "strength",
            "team",
            "learn-fast"
          ]
        },
        {
          "explanation": "Hojii darbe tokko jecha gabaabaa tokko ta'uu danda'a.",
          "examples": [
            "experience",
            "thank-interview"
          ]
        }
      ]
    }
  },
  "phrases": [
    {
      "id": "why-job",
      "english": {
        "text": "I want this job."
      },
      "meaning": {
        "en": {
          "text": "This is the job I hope to get."
        },
        "am": {
          "text": "ይህን ሥራ እፈልጋለሁ።"
        },
        "om": {
          "text": "Hojii kana barbaada."
        }
      },
      "hint": {
        "en": "Want names what you hope for.",
        "am": "Want የሚፈልጉትን ይሰይማል።",
        "om": "Want waan barbaaddu moggaasa."
      }
    },
    {
      "id": "strength",
      "english": {
        "text": "I am a careful worker."
      },
      "meaning": {
        "en": {
          "text": "I work with care."
        },
        "am": {
          "text": "ጥንቃቄ ያለኝ ሠራተኛ ነኝ።"
        },
        "om": {
          "text": "Hojjetaa of eeggannoo qabuun dha."
        }
      },
      "hint": {
        "en": "Careful describes how you work.",
        "am": "Careful እንዴት እንደሚሠሩ ይገልጻል።",
        "om": "Careful akka hojjettu ibsa."
      }
    },
    {
      "id": "team",
      "english": {
        "text": "I work well with people."
      },
      "meaning": {
        "en": {
          "text": "I cooperate with other people."
        },
        "am": {
          "text": "ከሰዎች ጋር በደንብ እሠራለሁ።"
        },
        "om": {
          "text": "Nama waliin gaariitti hojjedha."
        }
      },
      "hint": {
        "en": "With people names your team.",
        "am": "With people ቡድንዎን ይሰይማል።",
        "om": "With people garee kee ibsa."
      }
    },
    {
      "id": "experience",
      "english": {
        "text": "I worked in a shop."
      },
      "meaning": {
        "en": {
          "text": "A shop was my past workplace."
        },
        "am": {
          "text": "በሱቅ ውስጥ ሠርቻለሁ።"
        },
        "om": {
          "text": "Suuqii keessatti hojjedheera."
        }
      },
      "hint": {
        "en": "Worked is the past of work.",
        "am": "Worked የ work ያለፈ ጊዜ ነው።",
        "om": "Worked yeroo darbe hojjechuudha."
      }
    },
    {
      "id": "learn-fast",
      "english": {
        "text": "I learn quickly."
      },
      "meaning": {
        "en": {
          "text": "I pick things up fast."
        },
        "am": {
          "text": "በፍጥነት እማራለሁ።"
        },
        "om": {
          "text": "Dafnee baradha."
        }
      },
      "hint": {
        "en": "Quickly tells the speed.",
        "am": "Quickly ፍጥነቱን ይነግራል።",
        "om": "Quickly saffisa hima."
      }
    },
    {
      "id": "question-back",
      "english": {
        "text": "May I ask a question?"
      },
      "meaning": {
        "en": {
          "text": "I would like to ask something."
        },
        "am": {
          "text": "ጥያቄ ልጠይቅ?"
        },
        "om": {
          "text": "Gaaffii gaafadhaa?"
        }
      },
      "hint": {
        "en": "Use this near the end of the interview.",
        "am": "ይህንን ወደ ቃለ መጠይቁ መጨረሻ ይጠቀሙ።",
        "om": "Xumura af-gaaffii irratti kanaan fayyadami."
      }
    },
    {
      "id": "available",
      "english": {
        "text": "I can start on Monday."
      },
      "meaning": {
        "en": {
          "text": "Monday is the day I can begin."
        },
        "am": {
          "text": "ሰኞ መጀመር እችላለሁ።"
        },
        "om": {
          "text": "Wiixata jalqabuu nan danda'a."
        }
      },
      "hint": {
        "en": "On Monday names the day.",
        "am": "On Monday ቀኑን ይሰይማል።",
        "om": "On Monday guyyaa moggaasa."
      }
    },
    {
      "id": "thank-interview",
      "english": {
        "text": "Thank you for your time."
      },
      "meaning": {
        "en": {
          "text": "I appreciate the time you gave me."
        },
        "am": {
          "text": "ስለ ጊዜዎ አመሰግናለሁ።"
        },
        "om": {
          "text": "Yeroo keetiif galatoomi."
        }
      },
      "hint": {
        "en": "Say this when the interview ends.",
        "am": "ቃለ መጠይቁ ሲያልቅ ይህንን ይበሉ።",
        "om": "Af-gaaffiin yoo xumuramu kana jedhi."
      }
    }
  ],
