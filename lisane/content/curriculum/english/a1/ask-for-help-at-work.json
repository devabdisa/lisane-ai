{
  "id": "ask-for-help-at-work",
  "section": "a1",
  "position": 1,
  "review": {
    "en": "draft",
    "am": "draft",
    "om": "draft"
  },
  "guidebook": {
    "en": {
      "title": "Ask for help at work",
      "goal": "Ask for help, say you do not understand, and thank someone.",
      "introduction": "On a new job you will need help. These phrases keep the conversation polite and clear.",
      "notes": [
        {
          "explanation": "Can and could make a request softer.",
          "examples": [
            "need-help",
            "say-again",
            "ask-manager"
          ]
        },
        {
          "explanation": "Use these when you miss what someone said.",
          "examples": [
            "dont-understand",
            "one-moment",
            "where-is"
          ]
        },
        {
          "explanation": "Close the request by thanking the person.",
          "examples": [
            "thank-help",
            "this-way"
          ]
        }
      ]
    },
    "am": {
      "title": "በሥራ ቦታ እርዳታ ይጠይቁ",
      "goal": "እርዳታ ይጠይቁ፣ እንዳልገባዎት ይናገሩ እና ያመስግኑ።",
      "introduction": "በአዲስ ሥራ እርዳታ ያስፈልግዎታል። እነዚህ ሐረጎች ውይይቱን ጨዋ እና ግልጽ ያደርጉታል።",
      "notes": [
        {
          "explanation": "Can እና could ጥያቄውን ለስላሳ ያደርጉታል።",
          "examples": [
            "need-help",
            "say-again",
            "ask-manager"
          ]
        },
        {
          "explanation": "ሰው የተናገረው ሳይሰማዎት እነዚህን ይጠቀሙ።",
          "examples": [
            "dont-understand",
            "one-moment",
            "where-is"
          ]
        },
        {
          "explanation": "ጥያቄውን ሰውየውን በማመስገን ይዝጉ።",
          "examples": [
            "thank-help",
            "this-way"
          ]
        }
      ]
    },
    "om": {
      "title": "Bakka hojiitti gargaarsa gaafadhu",
      "goal": "Gargaarsa gaafadhu, akka hin hubanne himi, akkasumas galateeffadhu.",
      "introduction": "Hojii haaraa irratti gargaarsi si barbaachisa. Jechoonni kun haasawa kee ifa fi naafayaa taasisa.",
      "notes": [
        {
          "explanation": "Can fi could gaaffii kee laafisa.",
          "examples": [
            "need-help",
            "say-again",
            "ask-manager"
          ]
        },
        {
          "explanation": "Waan nama tokko jedhe yoo hin hubanne kanatti fayyadami.",
          "examples": [
            "dont-understand",
            "one-moment",
            "where-is"
          ]
        },
        {
          "explanation": "Gaaffii kee nama sana galateeffachuun xumuri.",
          "examples": [
            "thank-help",
            "this-way"
          ]
        }
      ]
    }
  },
  "phrases": [
    {
      "id": "need-help",
      "english": {
        "text": "Can you help me?"
      },
      "meaning": {
        "en": {
          "text": "Please give me some help."
        },
        "am": {
          "text": "ሊረዱኝ ይችላሉ?"
        },
        "om": {
          "text": "Na gargaaruu dandeessaa?"
        }
      },
      "hint": {
        "en": "Can you starts a polite request.",
        "am": "Can you ጨዋ ጥያቄ ይጀምራል።",
        "om": "Can you gaaffii naafayaa jalqaba."
      }
    },
    {
      "id": "dont-understand",
      "english": {
        "text": "I don't understand."
      },
      "meaning": {
        "en": {
          "text": "The meaning is not clear to me."
        },
        "am": {
          "text": "አልገባኝም።"
        },
        "om": {
          "text": "Hin hubadhu."
        }
      },
      "hint": {
        "en": "Say this when the meaning is not clear.",
        "am": "ሐሳቡ ግልጽ ካልሆነ ይህንን ይበሉ።",
        "om": "Hiikaa yoo hin ifne kana jedhi."
      }
    },
    {
      "id": "say-again",
      "english": {
        "text": "Could you say that again?"
      },
      "meaning": {
        "en": {
          "text": "Please repeat that."
        },
        "am": {
          "text": "እንደገና ሊሉኝ ይችላሉ?"
        },
        "om": {
          "text": "Ammas naaf himuu dandeessaa?"
        }
      },
      "hint": {
        "en": "Again asks for a repeat.",
        "am": "Again ድገማ ይጠይቃል።",
        "om": "Again irra deebi'ii gaafata."
      }
    },
    {
      "id": "where-is",
      "english": {
        "text": "Where is the office?"
      },
      "meaning": {
        "en": {
          "text": "I need the location of the office."
        },
        "am": {
          "text": "ቢሮው የት ነው?"
        },
        "om": {
          "text": "Waajjirri eessa?"
        }
      },
      "hint": {
        "en": "Where asks for a place.",
        "am": "Where ቦታ ይጠይቃል።",
        "om": "Where bakka gaafata."
      }
    },
    {
      "id": "this-way",
      "english": {
        "text": "It's this way."
      },
      "meaning": {
        "en": {
          "text": "The direction is here."
        },
        "am": {
          "text": "ወደዚህ ነው።"
        },
        "om": {
          "text": "Karaa kanaan."
        }
      },
      "hint": {
        "en": "Use this when you show a direction.",
        "am": "አቅጣጫ ሲያሳዩ ይህንን ይጠቀሙ።",
        "om": "Kallattii agarsiistu kanaan fayyadami."
      }
    },
    {
      "id": "ask-manager",
      "english": {
        "text": "May I ask my manager?"
      },
      "meaning": {
        "en": {
          "text": "I want permission to speak to my manager."
        },
        "am": {
          "text": "ሥራ አስኪያጄን ልጠይቅ?"
        },
        "om": {
          "text": "Bulchaa koo gaafadhaa?"
        }
      },
      "hint": {
        "en": "May I asks for permission.",
        "am": "May I ፈቃድ ይጠይቃል።",
        "om": "May I hayyama gaafata."
      }
    },
    {
      "id": "thank-help",
      "english": {
        "text": "Thank you for your help."
      },
      "meaning": {
        "en": {
          "text": "I am grateful for the help."
        },
        "am": {
          "text": "ስለ እርዳታዎ አመሰግናለሁ።"
        },
        "om": {
          "text": "Gargaarsa keetiif galatoomi."
        }
      },
      "hint": {
        "en": "For your help names the reason.",
        "am": "For your help ምክንያቱን ይሰይማል።",
        "om": "For your help sababa ibsa."
      }
    },
    {
      "id": "one-moment",
      "english": {
        "text": "One moment, please."
      },
      "meaning": {
        "en": {
          "text": "Please wait a short time."
        },
        "am": {
          "text": "አንድ ደቂቃ እባክዎ።"
        },
        "om": {
          "text": "Turtii xiqqoo, maaloo."
        }
      },
      "hint": {
        "en": "Please keeps the pause polite.",
        "am": "Please ማቆምዎን ጨዋ ያደርገዋል።",
        "om": "Please yeroo dhaabatu naafayaa taasisa."
      }
    }
  ],
