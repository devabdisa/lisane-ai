{
  "id": "describe-your-day",
  "section": "intro",
  "position": 2,
  "review": {
    "en": "draft",
    "am": "draft",
    "om": "draft"
  },
  "guidebook": {
    "en": {
      "title": "Describe your day",
      "goal": "Say when you wake up, go to work, and come home.",
      "introduction": "A coworker asks about your day. Learn a few short sentences for times and places.",
      "notes": [
        {
          "explanation": "Say the time with at. Then you can ask the other person.",
          "examples": [
            "wake-up",
            "start-time",
            "ask-start"
          ]
        },
        {
          "explanation": "By names how you travel. In the evening says when you go home.",
          "examples": [
            "commute",
            "evening",
            "finish-time"
          ]
        },
        {
          "explanation": "At home and at noon name the place or time of a meal.",
          "examples": [
            "breakfast",
            "lunch"
          ]
        }
      ]
    },
    "am": {
      "title": "ቀንዎን ይግለጹ",
      "goal": "መቼ እንደሚነሱ፣ ወደ ሥራ እንደሚሄዱ እና ወደ ቤት እንደሚመለሱ ይናገሩ።",
      "introduction": "የሥራ ባልደረባ ስለ ቀንዎ ይጠይቃል። ለሰዓት እና ለቦታ ጥቂት አጫጭር ዓረፍተ ነገሮችን ይማሩ።",
      "notes": [
        {
          "explanation": "ሰዓቱን at በማለት ይናገሩ። ከዚያም ሌላውን ሰው መጠየቅ ይችላሉ።",
          "examples": [
            "wake-up",
            "start-time",
            "ask-start"
          ]
        },
        {
          "explanation": "By መጓዝዎን ይገልጻል። In the evening መቼ ወደ ቤት እንደሚሄዱ ይናገራል።",
          "examples": [
            "commute",
            "evening",
            "finish-time"
          ]
        },
        {
          "explanation": "At home እና at noon የምግብ ቦታ ወይም ሰዓት ይሰይማሉ።",
          "examples": [
            "breakfast",
            "lunch"
          ]
        }
      ]
    },
    "om": {
      "title": "Guyyaa kee ibsi",
      "goal": "Yeroo kaatu, gara hojiitti deemtu fi gara manaatti deebitu himi.",
      "introduction": "Hojjetaan waa'ee guyyaa kee si gaafata. Jechoota gabaabaa yeroo fi bakka ibsan muraasa baradhu.",
      "notes": [
        {
          "explanation": "Sa'aatii at jedhii himi. Sana booda nama biraa gaafachuu dandeessa.",
          "examples": [
            "wake-up",
            "start-time",
            "ask-start"
          ]
        },
        {
          "explanation": "By akka deemtu ibsa. In the evening yeroo gara manaatti deebitu hima.",
          "examples": [
            "commute",
            "evening",
            "finish-time"
          ]
        },
        {
          "explanation": "At home fi at noon bakka ykn yeroo nyaataa moggaasa.",
          "examples": [
            "breakfast",
            "lunch"
          ]
        }
      ]
    }
  },
  "phrases": [
    {
      "id": "wake-up",
      "english": {
        "text": "I wake up at six."
      },
      "meaning": {
        "en": {
          "text": "I get out of bed at 6."
        },
        "am": {
          "text": "ስድስት ሰዓት እነሳለሁ።"
        },
        "om": {
          "text": "Sa'aatii ja'atti ka'a."
        }
      },
      "hint": {
        "en": "Use at before the hour.",
        "am": "ከሰዓቱ በፊት at ይጠቀሙ።",
        "om": "Sa'aatii dura at fayyadami."
      }
    },
    {
      "id": "breakfast",
      "english": {
        "text": "I eat breakfast at home."
      },
      "meaning": {
        "en": {
          "text": "I have my morning meal at home."
        },
        "am": {
          "text": "ቁርስ በቤት እበላለሁ።"
        },
        "om": {
          "text": "Ijaaja mana keessatti nyaadha."
        }
      },
      "hint": {
        "en": "At home names the place.",
        "am": "At home ቦታውን ይሰይማል።",
        "om": "At home bakka ibsa."
      }
    },
    {
      "id": "commute",
      "english": {
        "text": "I go to work by bus."
      },
      "meaning": {
        "en": {
          "text": "The bus takes me to work."
        },
        "am": {
          "text": "ወደ ሥራ በአውቶቡስ እሄዳለሁ።"
        },
        "om": {
          "text": "Gara hojiitti awutoobusiin deema."
        }
      },
      "hint": {
        "en": "By names the transport.",
        "am": "By መጓጓዣውን ይሰይማል።",
        "om": "By geejjibaa moggaasa."
      }
    },
    {
      "id": "start-time",
      "english": {
        "text": "I start work at eight."
      },
      "meaning": {
        "en": {
          "text": "My work begins at 8."
        },
        "am": {
          "text": "ስምንት ሰዓት ሥራ እጀምራለሁ።"
        },
        "om": {
          "text": "Hojii sa'aatii saddeettiitti jalqaba."
        }
      },
      "hint": {
        "en": "Use this for the hour you begin.",
        "am": "ሥራ ለሚጀምሩበት ሰዓት ይህንን ይጠቀሙ።",
        "om": "Sa'aatii hojii itti eegaltuuf kanaan fayyadami."
      }
    },
    {
      "id": "lunch",
      "english": {
        "text": "I eat lunch at noon."
      },
      "meaning": {
        "en": {
          "text": "I have my midday meal at 12."
        },
        "am": {
          "text": "ቀትር ላይ ምሳ እበላለሁ።"
        },
        "om": {
          "text": "Laaqana guyyaa walakkaa nyaadha."
        }
      },
      "hint": {
        "en": "Noon is the middle of the day.",
        "am": "Noon የቀኑ መሃል ነው።",
        "om": "Noon walakkaa guyyaati."
      }
    },
    {
      "id": "finish-time",
      "english": {
        "text": "I finish work at five."
      },
      "meaning": {
        "en": {
          "text": "My work ends at 5."
        },
        "am": {
          "text": "አምስት ሰዓት ሥራ እጨርሳለሁ።"
        },
        "om": {
          "text": "Hojii sa'aatii shanitti xumura."
        }
      },
      "hint": {
        "en": "Finish means the workday ends.",
        "am": "Finish የሥራ ቀን ማለቁን ይገልጻል።",
        "om": "Finish hojiin guyyaa akka xumuramu ibsa."
      }
    },
    {
      "id": "evening",
      "english": {
        "text": "I go home in the evening."
      },
      "meaning": {
        "en": {
          "text": "I return home later in the day."
        },
        "am": {
          "text": "ማታ ወደ ቤት እመለሳለሁ።"
        },
        "om": {
          "text": "Galgala gara manaatti deebi'a."
        }
      },
      "hint": {
        "en": "In the evening names the time of day.",
        "am": "In the evening የቀኑን ሰዓት ይሰይማል።",
        "om": "In the evening yeroo guyyaa ibsa."
      }
    },
    {
      "id": "ask-start",
      "english": {
        "text": "What time do you start?"
      },
      "meaning": {
        "en": {
          "text": "When do you begin?"
        },
        "am": {
          "text": "ስንት ሰዓት ይጀምራሉ?"
        },
        "om": {
          "text": "Sa'aatii meeqa hojii jalqabdu?"
        }
      },
      "hint": {
        "en": "Use this to ask about someone's start time.",
        "am": "የሰውን የመጀመሪያ ሰዓት ለመጠየቅ ይህንን ይጠቀሙ።",
        "om": "Yeroo nama biraa gaafachuuf kanaan fayyadami."
      }
    }
  ],
