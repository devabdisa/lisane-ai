  "guidebook": {
    "en": {
      "title": "Introduce yourself at work",
      "goal": "Greet a new coworker, say your name, and tell them what you do.",
      "introduction": "Imagine it is your first day at a new job. Learn a few short phrases you can put together when you meet a coworker.",
      "notes": [
        {
          "explanation": "Start with a greeting and your name. Then you can ask the other person their name or say you are glad to meet them.",
          "examples": [
            "say-your-name",
            "ask-their-name",
            "meeting-greeting"
          ]
        },
        {
          "explanation": "The first example gives a job title. The second names the kind of work, and the third names the workplace.",
          "examples": [
            "say-your-job",
            "work-in-sales",
            "work-at-a-clinic"
          ]
        },
        {
          "explanation": "When someone asks about your work, give one short answer. Use your own job or workplace when you practise aloud.",
          "examples": [
            "ask-about-work",
            "work-in-customer-service",
            "new-here"
          ]
        }
      ]
    },
    "am": {
      "title": "በሥራ ቦታ ራስዎን ያስተዋውቁ",
      "goal": "አዲስ የስራ ባልደረባን ሰላም ይበሉ፣ ስምዎን ይናገሩ እና ምን እንደሚሰሩ ይንገሯቸው።",
      "introduction": "በአዲስ ስራ የመጀመሪያ ቀንዎ እንደሆነ አስቡት። የስራ ባልደረባዎን ሲያገኙ አብረው ሊጠቀሙባቸው የሚችሉ ጥቂት አጫጭር ሀረጎችን ይማሩ።",
      "notes": [
        {
          "explanation": "ሰላምታ በማቅረብ እና ስምዎን በመግለጽ ይጀምሩ። ከዚያም የሌላውን ሰው ስም መጠየቅ ወይም እሱን በማግኘቶት ደስ እንዳሎት መናገር ይችላሉ።",
          "examples": [
            "say-your-name",
            "ask-their-name",
            "meeting-greeting"
          ]
        },
        {
          "explanation": "የመጀመሪያው ምሳሌ የሥራ መጠሪያን ይሰጣል። ሁለተኛው የሥራውን ዓይነት ሲሰይም፣ ሦስተኛው ደግሞ የሥራ ቦታውን ይሰይማል።",
          "examples": [
            "say-your-job",
            "work-in-sales",
            "work-at-a-clinic"
          ]
        },
        {
          "explanation": "አንድ ሰው ስለስራዎ ሲጠይቅ፣ አንድ አጭር መልስ ይስጡ። ጮክ ብለው ሲለማመዱ የራስዎን ስራ ወይም የስራ ቦታ ይጠቀሙ።",
          "examples": [
            "ask-about-work",
            "work-in-customer-service",
            "new-here"
          ]
        }
      ]
    },
    "om": {
      "title": "Bakka hojiitti of beeksisuu",
      "goal": "Hojjetaa haaraa nagaa gaafadhu, maqaa kee itti himi, akkasumas hojii kee itti himi.",
      "introduction": "Guyyaa jalqabaa hojii haaraa kee akka ta'etti yaadi. Jechoota gabaabaa yeroo hojjetaa biroo wajjin wal bartu walitti fiduu dandeessu muraasa baradhu.",
      "notes": [
        {
          "explanation": "Nagaa gaafachuu fi maqaa keetiin jalqabi. Sana booda maqaa nama sanaa gaafachuu ykn isaan arguun kee akka sitti tole itti himuu dandeessa.",
          "examples": [
            "say-your-name",
            "ask-their-name",
            "meeting-greeting"
          ]
        },
        {
          "explanation": "Fakkeenyi jalqabaa maqaa hojii kenna. Inni lammaffaan gosa hojii yoo ta'u, inni sadaffaan immoo bakka hojii ibsa.",
          "examples": [
            "say-your-job",
            "work-in-sales",
            "work-at-a-clinic"
          ]
        },
        {
          "explanation": "Namni tokko waa'ee hojii kee yoo si gaafate, deebii gabaabaa tokko kenni. Yeroo sagalee kee ol kaastee shaakaltu hojii kee ykn bakka hojii kee fayyadami.",
          "examples": [
            "ask-about-work",
            "work-in-customer-service",
            "new-here"
          ]
        }
      ]
    }
  },
  "phrases": [
    {
      "id": "say-your-name",
      "english": {
        "text": "Hi, I'm Hana.",
        "alternatives": [
          "Hi, I am Hana.",
          "Hi, I’m Hanna.",
          "Hi, I am Hanna.",
          "Hi, I’m Hannah.",
          "Hi, I am Hannah."
        ]
      },
      "meaning": {
        "en": {
          "text": "Hello, my name is Hana."
        },
        "am": {
          "text": "ሰላም፣ እኔ ሃና ነኝ።"
        },
        "om": {
          "text": "Akkam, ani Haanaa dha."
        }
      },
      "hint": {
        "en": "Start with a greeting, then say your name.",
        "am": "ሰላምታ በማቅረብ ይጀምሩ፣ ከዚያም ስምዎን ይናገሩ።",
        "om": "Nagaa gaafachuun jalqabi, sana booda maqaa kee himi."
      }
    },
    {
      "id": "ask-their-name",
      "english": {
        "text": "What's your name?",
        "alternatives": [
          "What is your name?"
        ]
      },
      "meaning": {
        "en": {
          "text": "What should I call you?"
        },
        "am": {
          "text": "ስምዎ ማን ነው?"
        },
        "om": {
          "text": "Maqaan kee eenyu?"
        }
      },
      "hint": {
        "en": "Use this question to learn someone's name.",
        "am": "የአንድን ሰው ስም ለማወቅ ይህንን ጥያቄ ይጠቀሙ።",
        "om": "Maqaa nama tokkoo baruuf gaaffii kana fayyadami."
      }
    },
    {
      "id": "meeting-greeting",
      "english": {
        "text": "Nice to meet you."
      },
      "meaning": {
        "en": {
          "text": "I'm glad we met."
        },
        "am": {
          "text": "ስላገኘሁዎት ደስ ብሎኛል።"
        },
        "om": {
          "text": "Si arguu kootti gammadeera."
        }
      },
      "hint": {
        "en": "Say this when you meet someone for the first time.",
        "am": "አንድን ሰው ለመጀመሪያ ጊዜ ሲያገኙ ይህንን ይበሉ።",
        "om": "Yeroo nama tokko yeroo jalqabaatiif wal argitan kana jedhaa."
      }
    },
    {
      "id": "new-here",
      "english": {
        "text": "I'm new here.",
        "alternatives": [
          "I am new here."
        ]
      },
      "meaning": {
        "en": {
          "text": "I just joined this place."
        },
        "am": {
          "text": "እዚህ አዲስ ነኝ።"
        },
        "om": {
          "text": "Ani asitti haaraadha."
        }
      },
      "hint": {
        "en": "Use this to tell a coworker you have just joined.",
        "am": "አሁን እንደተቀላቀሉ ለስራ ባልደረባዎ ለመንገር ይህንን ይጠቀሙ።",
        "om": "Hojjetaa waliin hojjettu tokkotti akka dhiheenya kana itti makamte itti himuuf kanatti fayyadami."
      }
    },
    {
      "id": "ask-about-work",
      "english": {
        "text": "What do you do?"
      },
      "meaning": {
        "en": {
          "text": "What is your job?"
        },
        "am": {
          "text": "ምን ሥራ ይሠራሉ?"
        },
        "om": {
          "text": "Maal hojjetta?"
        }
      },
      "hint": {
        "en": "Ask this when you want to know someone's job.",
        "am": "የአንድን ሰው ስራ ማወቅ ሲፈልጉ ይህንን ይጠይቁ።",
        "om": "Yeroo hojii nama tokkoo beekuu barbaaddu kana gaafadhu."
      }
    },
    {
      "id": "work-in-sales",
      "english": {
        "text": "I work in sales."
      },
      "meaning": {
        "en": {
          "text": "My work is selling things."
        },
        "am": {
          "text": "በሽያጭ ዘርፍ እሠራለሁ።"
        },
        "om": {
          "text": "Ani gurgurtaa irratti nan hojjadha."
        }
      },
      "hint": {
        "en": "Use this pattern to name the kind of work you do.",
        "am": "የሚያከናውኑትን የሥራ ዓይነት ለመሰየም ይህንን ዘይቤ ይጠቀሙ።",
        "om": "Akaakuu hojii ati hojjettu maqaa itti kennuuf fakkeenya kana fayyadami."
      }
    },
    {
      "id": "say-your-job",
      "english": {
        "text": "I'm a nurse.",
        "alternatives": [
          "I am a nurse."
        ]
      },
      "meaning": {
        "en": {
          "text": "My job is nursing."
        },
        "am": {
          "text": "እኔ ነርስ ነኝ።"
        },
        "om": {
          "text": "Ani narsiidha."
        }
      },
      "hint": {
        "en": "Use this pattern before a job title.",
        "am": "ከሥራ መጠሪያ በፊት ይህንን ዘይቤ ይጠቀሙ።",
        "om": "Maqaa hojii dura bifa kanaan fayyadami."
      }
    },
    {
      "id": "work-at-a-clinic",
      "english": {
        "text": "I work at a clinic."
      },
      "meaning": {
        "en": {
          "text": "A clinic is my workplace."
        },
        "am": {
          "text": "ክሊኒክ ውስጥ እሠራለሁ።"
        },
        "om": {
          "text": "Ani kilinika tokko keessatti hojjedha."
        }
      },
      "hint": {
        "en": "Use this pattern to name your workplace.",
        "am": "የሥራ ቦታዎን ለመሰየም ይህንን ዘይቤ ይጠቀሙ።",
        "om": "Bakka hojii kee moggaasuuf fakkeenya kana fayyadami."
      }
    },
    {
      "id": "work-in-customer-service",
      "english": {
        "text": "I work in customer service."
      },
      "meaning": {
        "en": {
          "text": "My job is to help customers."
        },
        "am": {
          "text": "የደንበኞች አገልግሎት እሰራለሁ።"
        },
        "om": {
          "text": "Ani tajaajila maamiltootaa irratti hojjedha."
        }
      },
      "hint": {
        "en": "Use this to say that you help customers at work.",
        "am": "ይህንን በስራ ቦታ ደንበኞችን እንደሚረዱ ለመግለጽ ይጠቀሙበት።",
        "om": "Bakka hojiitti maamiltoota akka gargaartu himuuf kanaan fayyadami."
      }
    }
  ],
