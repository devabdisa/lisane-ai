# Copy to .env.local and fill in. All keys are server-side only; never prefix secrets with NEXT_PUBLIC_.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (hosted Postgres)
DATABASE_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini. Live and TTS names match the Voxa environment.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview

# Speech-to-text provider: gemini (default) or groq
STT_PROVIDER=gemini
GROQ_API_KEY=

# Addis AI (support-language explanations and translation)
ADDIS_API_KEY=

# Chapa payments (use test keys locally)
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
